# Dedicated project PostgreSQL. Use a URL-safe random password (openssl rand -hex 32).
DB_PASSWORD=CHANGE_ME
POSTGRES_PORT=5435
# Application metadata: accounts, cubes, sessions, query evidence. PostgreSQL only.
DATABASE_URL=postgresql://chat_olap:${DB_PASSWORD}@localhost:${POSTGRES_PORT}/chat_olap
# Prefer a dedicated read-only role for business tables. Empty = DATABASE_URL.
ANALYTICS_DATABASE_URL=
# Optional separate analytics source inside Docker; blank uses the project database.
DOCKER_ANALYTICS_DATABASE_URL=
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3001
# Explicit business schema allowlist. Never include chat_olap or system schemas.
ANALYTICS_SCHEMAS=["public"]
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TOKEN_MINUTES=120
ALLOW_SIGNUP=true
OPENAI_API_KEY=
# Explicit model with function calling and Structured Outputs support. No model fallback.
OPENAI_MODEL=gpt-6-luna
LLM_TIMEOUT_SECONDS=40
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=180
QUERY_TIMEOUT_MS=10000
MAX_RESULT_ROWS=200
LOG_LEVEL=INFO

# CSV/SQLite imports: bounded file size, rows, tables and columns.
UPLOAD_MAX_BYTES=26214400
IMPORT_MAX_ROWS=100000
IMPORT_MAX_TABLES=50
IMPORT_MAX_COLUMNS=128
IMPORT_TIMEOUT_MS=60000
MAX_IMPORTED_SOURCES=50
